# === Telegram ===
# Token dari @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# ID grup tujuan penyimpanan file (angka negatif untuk grup, mis. -1001234567890)
# Cara dapat: add bot @userinfobot ke grup, atau forward pesan dari grup ke @RawDataBot
GROUP_ID=-1001234567890

# URL Local Bot API Server yang jalan di VM ini (default port 8081)
LOCAL_API_URL=http://127.0.0.1:8081

# Ukuran maksimal per chunk sebelum file dipecah (dalam MB).
# Local Bot API Server default max = 2000MB. Kasih margin, jangan mepet.
CHUNK_SIZE_MB=1900

# Ukuran per-block resumable upload dari browser (dalam MB). Semakin kecil,
# semakin granular resume-nya kalau koneksi putus, tapi makin banyak request.
UPLOAD_BLOCK_SIZE_MB=8

# === App ===
PORT=3000
JWT_SECRET=ganti-dengan-random-string-panjang-dan-acak

# Umur access token (JWT pendek, dipakai tiap request). Kalau kadaluarsa,
# frontend otomatis minta yang baru pakai refresh token (lihat di bawah),
# jadi user tidak perlu login ulang tiap 15 menit.
ACCESS_TOKEN_EXPIRES_IN=15m
# Umur refresh token dalam HARI. Ini yang nentuin "berapa lama sebelum harus
# login ulang pakai password lagi". Rotate otomatis tiap dipakai.
REFRESH_TOKEN_DAYS=30
# Legacy: kalau var ini di-set (dari .env versi lama sebelum refresh token
# ada), dipakai sebagai fallback ACCESS_TOKEN_EXPIRES_IN. Boleh dihapus.
# JWT_EXPIRES_IN=7d

# Domain yang boleh akses API ini via browser (CORS), pisah koma kalau lebih dari satu.
# Kosongkan (biarkan default) kalau hanya diakses lewat domain/app ini sendiri.
ALLOWED_ORIGINS=

# Batas maksimal ukuran satu file upload, dalam MB. Cegah disk VM habis.
MAX_UPLOAD_MB=10240

# Kuota total penyimpanan per user (dalam MB), default kalau tidak di-override.
# Set custom per user pakai: node scripts/set-quota.js <username> <mb>
DEFAULT_QUOTA_MB=5120

# Ambang batas (persen) buat kirim notifikasi DM Telegram kalau kuota user
# hampir penuh. Pisah koma buat beberapa level. User harus sudah "hubungkan
# akun Telegram" dulu lewat web (lihat README) supaya bot boleh DM mereka.
QUOTA_WARN_THRESHOLDS=80,95

# Direktori sementara untuk staging upload sebelum dikirim ke Telegram
TMP_DIR=./tmp
DB_PATH=./data/drive.db

# Kalau true, registrasi user baru lewat /api/auth/register ditutup
# (aktifkan setelah kamu bikin akun sendiri, supaya orang lain tidak bisa daftar sembarangan)
DISABLE_REGISTRATION=false
